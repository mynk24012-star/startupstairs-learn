---
interface Props {
  module: string;
  chapter: string;
}
const { module, chapter } = Astro.props;
---

<span data-check data-module={module} data-chapter={chapter} hidden class="inline-flex shrink-0 text-positive">
  <svg width="14" height="14" viewBox="0 0 16 16" aria-hidden="true">
    <path d="M3 8.5l3 3 7-7" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"></path>
  </svg>
  <span class="sr-only">Completed</span>
</span>
