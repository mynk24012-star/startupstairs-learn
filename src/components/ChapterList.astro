---
import type { Chapter, Module } from '../lib/schema';
import { chapterPath } from '../lib/modules';
import Check from './Check.astro';

interface Props {
  module: Module;
  current?: Chapter;
}
const { module, current } = Astro.props;
---

<ol class="space-y-0.5">
  {
    module.chapters.map((c, i) => {
      const active = current?.slug === c.slug;
      return (
        <li>
          <a
            href={chapterPath(module, c)}
            aria-current={active ? 'page' : undefined}
            class:list={[
              'flex items-start gap-3 rounded-r-md border-l-2 py-2 pr-2 pl-3 text-[0.9375rem] leading-snug',
              active
                ? 'border-accent bg-subtle font-medium text-ink'
                : 'border-transparent text-muted hover:border-line hover:text-ink',
            ]}
          >
            <span class="num w-5 shrink-0 pt-px text-xs text-muted">{String(i + 1).padStart(2, '0')}</span>
            <span class="flex-1">{c.title}</span>
            <Check module={module.slug} chapter={c.slug} />
          </a>
        </li>
      );
    })
  }
</ol>
