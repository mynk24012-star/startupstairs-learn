---
import type { Block } from '../../lib/schema';
import BlockHeading from './BlockHeading.astro';

interface Props {
  block: Extract<Block, { type: 'quiz' }>;
  moduleSlug: string;
  chapterSlug: string;
  uid: string;
}
const { block, moduleSlug, chapterSlug, uid } = Astro.props;
---

<BlockHeading text={block.heading} />
{block.intro && <p class="mt-4">{block.intro}</p>}

<form
  class="quiz mt-6 rounded-[var(--radius-card)] border border-line bg-surface"
  data-quiz
  data-module={moduleSlug}
  data-chapter={chapterSlug}
  data-answers={JSON.stringify(block.questions.map((q) => q.answer))}
  novalidate
>
  <div class="p-4 sm:p-5">
    {
      block.questions.map((q, i) => (
        <div class="quiz-row">
          <label for={`${uid}-q${i}`} class="flex-1 text-[0.9375rem]">
            {q.label}
          </label>
          <div class="flex items-center gap-1.5 text-muted">
            <span aria-hidden="true">₹</span>
            <input
              id={`${uid}-q${i}`}
              type="text"
              inputmode="numeric"
              autocomplete="off"
              class="field num w-32 text-right"
              aria-describedby={`${uid}-q${i}-msg`}
              data-answer-input
            />
          </div>
          <p id={`${uid}-q${i}-msg`} class="quiz-msg w-full text-sm" data-msg aria-live="polite" />
        </div>
      ))
    }
  </div>

  <div class="flex flex-wrap items-center gap-3 border-t border-line p-4 sm:px-5">
    <button type="submit" class="btn btn-primary">Check answers</button>
    <button type="button" class="btn btn-secondary" aria-expanded="false" aria-controls={`${uid}-key`} data-show
      >Show answers</button
    >
    <p class="w-full text-sm text-ink sm:w-auto" role="status" data-summary></p>
  </div>

  <div id={`${uid}-key`} hidden class="border-t border-line bg-subtle p-4 sm:px-5" data-key>
    <p class="text-sm font-medium">Answer key</p>
    <ol class="mt-2 list-decimal space-y-1 pl-5">
      {block.answerKey.map((a) => <li>{a}</li>)}
    </ol>
  </div>
</form>

<style>
  .quiz-row {
    display: flex;
    flex-wrap: wrap;
    align-items: center;
    column-gap: 1rem;
    row-gap: 0.25rem;
    padding: 0.625rem 0;
    border-bottom: 1px solid var(--color-line);
  }
  .quiz-row:last-child {
    border-bottom: 0;
  }
  .quiz-msg:empty {
    display: none;
  }
</style>

<script>
  import { parseAmount, formatINR } from '../../lib/format';
  import { setComplete, initProgress } from '../../scripts/progress';

  initProgress();

  document.querySelectorAll<HTMLFormElement>('[data-quiz]').forEach((form) => {
    const answers = JSON.parse(form.dataset.answers!) as number[];
    const inputs = [...form.querySelectorAll<HTMLInputElement>('[data-answer-input]')];
    const summary = form.querySelector<HTMLElement>('[data-summary]')!;
    const show = form.querySelector<HTMLButtonElement>('[data-show]')!;
    const key = form.querySelector<HTMLElement>('[data-key]')!;

    form.addEventListener('submit', (e) => {
      e.preventDefault();
      let correct = 0;
      inputs.forEach((input, i) => {
        const msg = input.closest('.quiz-row')!.querySelector<HTMLElement>('[data-msg]')!;
        const value = parseAmount(input.value);
        msg.classList.remove('text-positive', 'text-negative', 'text-muted');
        if (value === null) {
          msg.textContent = 'Enter a number.';
          msg.classList.add('text-muted');
          input.setAttribute('aria-invalid', 'true');
        } else if (value === answers[i]) {
          correct++;
          msg.textContent = 'Correct.';
          msg.classList.add('text-positive');
          input.removeAttribute('aria-invalid');
        } else {
          msg.textContent = 'Not quite. Check your working and try again.';
          msg.classList.add('text-negative');
          input.setAttribute('aria-invalid', 'true');
        }
      });
      if (correct === answers.length) {
        setComplete(form.dataset.module!, form.dataset.chapter!, true);
        summary.textContent = `All ${answers.length} correct. This chapter is marked as complete.`;
      } else {
        summary.textContent = `${correct} of ${answers.length} correct.`;
      }
    });

    show.addEventListener('click', () => {
      const open = key.hidden;
      key.hidden = !open;
      show.setAttribute('aria-expanded', String(open));
      show.textContent = open ? 'Hide answers' : 'Show answers';
    });

    // Keep typed amounts readable: 9000 becomes 9,000 when the field loses focus.
    inputs.forEach((input) =>
      input.addEventListener('blur', () => {
        const v = parseAmount(input.value);
        if (v !== null) input.value = formatINR(v).replace('₹', '');
      }),
    );
  });
</script>
