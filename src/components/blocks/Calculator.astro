---
import type { Block, Business } from '../../lib/schema';
import { formatINR, formatPercent } from '../../lib/format';
import BlockHeading from './BlockHeading.astro';

interface Props {
  block: Extract<Block, { type: 'calculator' }>;
  businesses: Business[];
  /** Unique per page, used to build input ids. */
  uid: string;
}
const { block, businesses, uid } = Astro.props;
const list = block.businesses ? businesses.filter((b) => block.businesses!.includes(b.id)) : businesses;
const first = list[0]!;
const total = first.costs.reduce((s, c) => s + c.amount, 0);
const profit = first.price - total;
---

<BlockHeading text={block.heading} />
{block.intro && <p class="mt-4">{block.intro}</p>}

<div
  class="calc mt-6 rounded-[var(--radius-card)] border border-line bg-surface"
  data-calculator
  data-uid={uid}
  data-businesses={JSON.stringify(list)}
>
  <div class="border-b border-line p-4 sm:p-5">
    <label for={`${uid}-preset`} class="block text-sm font-medium text-ink">Business</label>
    <select id={`${uid}-preset`} class="field mt-1.5 sm:max-w-xs" data-preset>
      {list.map((b) => <option value={b.id}>{b.label}</option>)}
    </select>
    <p class="mt-2 text-sm text-muted">Unit: <span data-unit>{first.unit}</span></p>
  </div>

  <div class="p-4 sm:p-5">
    <div class="calc-row">
      <label for={`${uid}-price`} class="font-medium">Selling price</label>
      <div class="money">
        <span aria-hidden="true">₹</span>
        <input
          id={`${uid}-price`}
          type="number"
          inputmode="numeric"
          min="0"
          step="1"
          class="field num"
          value={first.price}
          data-price
        />
      </div>
    </div>

    <p class="mt-5 text-sm font-medium text-muted" id={`${uid}-costs-label`}>Costs for one unit</p>
    <div data-costs role="group" aria-labelledby={`${uid}-costs-label`}>
      {
        first.costs.map((c, i) => (
          <div class="calc-row">
            <label for={`${uid}-cost-${i}`}>{c.label}</label>
            <div class="money">
              <span aria-hidden="true">₹</span>
              <input
                id={`${uid}-cost-${i}`}
                type="number"
                inputmode="numeric"
                min="0"
                step="1"
                class="field num"
                value={c.amount}
                data-cost
              />
            </div>
          </div>
        ))
      }
    </div>
  </div>

  <dl class="grid grid-cols-1 border-t border-line sm:grid-cols-3" aria-live="polite" aria-atomic="true">
    <div class="result">
      <dt>Total cost</dt>
      <dd class="num" data-out-total>{formatINR(total)}</dd>
    </div>
    <div class="result">
      <dt data-out-profit-label>{profit < 0 ? 'Loss per unit' : 'Profit per unit'}</dt>
      <dd class:list={['num', profit < 0 ? 'text-negative' : 'text-positive']} data-out-profit>{formatINR(profit)}</dd>
    </div>
    <div class="result">
      <dt>Profit as % of price</dt>
      <dd class:list={['num', profit < 0 ? 'text-negative' : 'text-positive']} data-out-margin>
        {formatPercent((profit / first.price) * 100)}
      </dd>
    </div>
  </dl>
  <p class="border-t border-line px-4 py-3 text-sm text-muted sm:px-5">
    Change any number. The results update as you type.
  </p>
</div>

<style is:global>
  /* Global because cost rows are rebuilt by the script below. Everything is scoped under .calc. */
  .calc .calc-row {
    display: flex;
    align-items: center;
    justify-content: space-between;
    gap: 1rem;
    padding: 0.5rem 0;
    border-bottom: 1px solid var(--color-line);
  }
  .calc .calc-row:last-child {
    border-bottom: 0;
  }
  .calc .calc-row label {
    flex: 1;
    font-size: 0.9375rem;
  }
  .calc .money {
    display: flex;
    align-items: center;
    gap: 0.375rem;
    color: var(--color-muted);
  }
  .calc .money input {
    width: 7.5rem;
    text-align: right;
  }
  .calc .result {
    padding: 1rem 1.25rem;
  }
  .calc .result + .result {
    border-top: 1px solid var(--color-line);
  }
  @media (min-width: 40rem) {
    .calc .result + .result {
      border-top: 0;
      border-left: 1px solid var(--color-line);
    }
  }
  .calc .result dt {
    font-size: 0.8125rem;
    color: var(--color-muted);
  }
  .calc .result dd {
    margin-top: 0.25rem;
    font-size: 1.25rem;
    font-weight: 500;
  }
</style>

<script>
  import { formatINR, formatPercent } from '../../lib/format';
  import type { Business } from '../../lib/schema';

  function money(id: string, value: number): HTMLDivElement {
    const wrap = document.createElement('div');
    wrap.className = 'money';
    const sign = document.createElement('span');
    sign.setAttribute('aria-hidden', 'true');
    sign.textContent = '₹';
    const input = document.createElement('input');
    Object.assign(input, { id, type: 'number', min: '0', step: '1', value: String(value), className: 'field num' });
    input.inputMode = 'numeric';
    input.dataset.cost = '';
    wrap.append(sign, input);
    return wrap;
  }

  const value = (el: HTMLInputElement) => {
    const n = Number(el.value);
    return Number.isFinite(n) ? n : 0;
  };

  document.querySelectorAll<HTMLElement>('[data-calculator]').forEach((root) => {
    const uid = root.dataset.uid!;
    const businesses = JSON.parse(root.dataset.businesses!) as Business[];
    const preset = root.querySelector<HTMLSelectElement>('[data-preset]')!;
    const price = root.querySelector<HTMLInputElement>('[data-price]')!;
    const costs = root.querySelector<HTMLElement>('[data-costs]')!;
    const unit = root.querySelector<HTMLElement>('[data-unit]')!;
    const outTotal = root.querySelector<HTMLElement>('[data-out-total]')!;
    const outProfit = root.querySelector<HTMLElement>('[data-out-profit]')!;
    const outLabel = root.querySelector<HTMLElement>('[data-out-profit-label]')!;
    const outMargin = root.querySelector<HTMLElement>('[data-out-margin]')!;

    function update() {
      const total = [...costs.querySelectorAll<HTMLInputElement>('[data-cost]')].reduce((s, el) => s + value(el), 0);
      const p = value(price);
      const profit = p - total;
      const tone = profit < 0 ? 'text-negative' : 'text-positive';
      outTotal.textContent = formatINR(total);
      outLabel.textContent = profit < 0 ? 'Loss per unit' : 'Profit per unit';
      outProfit.textContent = formatINR(profit);
      outMargin.textContent = p > 0 ? formatPercent((profit / p) * 100) : 'Enter a price';
      for (const el of [outProfit, outMargin]) {
        el.classList.remove('text-negative', 'text-positive');
        el.classList.add(tone);
      }
    }

    function load(id: string) {
      const b = businesses.find((x) => x.id === id);
      if (!b) return;
      unit.textContent = b.unit;
      price.value = String(b.price);
      costs.replaceChildren(
        ...b.costs.map((c, i) => {
          const row = document.createElement('div');
          row.className = 'calc-row';
          const label = document.createElement('label');
          label.htmlFor = `${uid}-cost-${i}`;
          label.textContent = c.label;
          row.append(label, money(`${uid}-cost-${i}`, c.amount));
          return row;
        }),
      );
      update();
    }

    preset.addEventListener('change', () => load(preset.value));
    root.addEventListener('input', (e) => {
      if ((e.target as Element).matches('input')) update();
    });
  });
</script>
