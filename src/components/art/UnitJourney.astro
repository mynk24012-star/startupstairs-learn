  <path class="ink" d="M538 198 L522 214 M538 198 L558 178" />
  <circle class="f-white" cx="538" cy="170" r="16" />
  <path class="f-lilac" d="M522 168 q0 -20 18 -18 q16 2 14 16 q-6 -8 -16 -6 q-8 -4 -16 8 Z" />
  <circle class="f-ink" cx="542" cy="171" r="1.6" />
