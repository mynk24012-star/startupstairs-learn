<svg viewBox="0 0 640 300" aria-hidden="true">
  <path class="ink" d="M20 262 H620" />
  <rect class="f-white" x="50" y="140" width="130" height="122" />
  <path class="f-coral" d="M40 140 L60 110 H170 L190 140 Z" />
  <path class="ink-thin" d="M88 110 L82 140 M115 110 V140 M142 110 L148 140" />
  <rect class="f-sky" x="96" y="198" width="38" height="64" />
  <rect class="f-sun" x="62" y="158" width="26" height="24" />
  <rect class="f-sun" x="142" y="158" width="26" height="24" />
  <rect class="f-white" x="72" y="80" width="86" height="24" rx="4" />
  <text class="t" x="115" y="97" font-size="13" text-anchor="middle">SHOP</text>

