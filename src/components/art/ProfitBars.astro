---
// Revenue minus cost equals profit, drawn as three bars.
---
<svg viewBox="0 0 640 300" aria-hidden="true">
  <path class="ink" d="M50 250 H590" />
  <rect class="f-sky m-bottom grow" x="80" y="80" width="100" height="170" rx="4" />
  <text class="t-mono" x="130" y="68" font-size="18" text-anchor="middle">₹500</text>
  <text class="t" x="130" y="278" font-size="15" text-anchor="middle">Revenue</text>

  <text class="t" x="215" y="190" font-size="44" text-anchor="middle">−</text>

  <rect class="f-coral m-bottom grow d2" x="250" y="134" width="100" height="116" rx="4" />
  <text class="t-mono" x="300" y="122" font-size="18" text-anchor="middle">₹340</text>
  <text class="t" x="300" y="278" font-size="15" text-anchor="middle">Cost</text>

  <text class="t" x="385" y="190" font-size="44" text-anchor="middle">=</text>

  <rect class="f-leaf m-bottom grow d4" x="420" y="196" width="100" height="54" rx="4" />
  <text class="t-mono" x="470" y="184" font-size="18" text-anchor="middle">₹160</text>
  <text class="t" x="470" y="278" font-size="15" text-anchor="middle">Profit</text>

  <g class="m bob">
    <ellipse class="f-sun" cx="562" cy="242" rx="18" ry="6" />
    <ellipse class="f-sun" cx="562" cy="232" rx="18" ry="6" />
    <ellipse class="f-sun" cx="562" cy="222" rx="18" ry="6" />
  </g>
</svg>
