---
// The five businesses from the worked examples.
const shops = [
  { label: 'Restaurant', fill: 'f-amber' },
  { label: 'Salon', fill: 'f-peach' },
  { label: 'Course', fill: 'f-orange' },
  { label: 'Shirt', fill: 'f-rose' },
  { label: 'Bakery', fill: 'f-red' },
];
---
<svg viewBox="0 0 640 300" aria-hidden="true">
  {
    shops.map((s, i) => {
      const x = 24 + i * 122;
      return (
        <g class={`m pop d${i + 1}`}>
          <rect class="f-white" x={x} y="60" width="104" height="170" rx="8" />
          <path class={s.fill} d={`M${x} 68 a8 8 0 0 1 8 -8 h88 a8 8 0 0 1 8 8 v92 h-104 Z`} />
          <text class="t" x={x + 52} y="200" font-size="14" text-anchor="middle">{s.label}</text>
          <g transform={`translate(${x + 52} 112)`}>
            {i === 0 && (
              <g>
                <path class="f-white" d="M-26 -2 H26 A26 24 0 0 1 -26 -2 Z" />
                <path class="ink-thin float" d="M-10 -12 q-6 -8 0 -16 M0 -12 q-6 -8 0 -16 M10 -12 q-6 -8 0 -16" />
              </g>
            )}
            {i === 1 && (
              <g>
                <path class="ink" d="M-7 8 L16 -26 M7 8 L-16 -26" />
                <circle class="f-white" cx="-12" cy="16" r="8" />
                <circle class="f-white" cx="12" cy="16" r="8" />
              </g>
            )}
            {i === 2 && (
              <g>
                <rect class="f-white" x="-28" y="-26" width="56" height="36" rx="3" />
                <path class="f-amber" d="M-6 -16 L8 -8 L-6 0 Z" />
                <path class="f-white" d="M-34 10 H34 L29 18 H-29 Z" />
              </g>
            )}
            {i === 3 && (
              <path class="f-white" d="M-12 -26 L-32 -14 L-24 0 L-17 -4 V26 H17 V-4 L24 0 L32 -14 L12 -26 Q0 -16 -12 -26 Z" />
            )}
            {i === 4 && (
              <g>
                <rect class="f-white" x="-26" y="-2" width="52" height="26" rx="3" />
                <rect class="f-peach" x="-17" y="-18" width="34" height="16" rx="3" />
                <path class="ink" d="M0 -18 V-30" />
                <path class="f-amber m flicker" d="M0 -42 q7 8 0 12 q-7 -4 0 -12 Z" />
              </g>
            )}
          </g>
        </g>
      );
    })
  }
</svg>
