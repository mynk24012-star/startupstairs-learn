---
// A founder climbs the stairs while a rocket lifts off. Used on /learn and as the default hero.
---
<svg viewBox="0 0 640 300" aria-hidden="true">
  <g class="m float-slow"><circle class="f-amber" cx="560" cy="62" r="26" /></g>
  <g class="drift"><path class="f-white" d="M70 78 q4 -22 26 -18 q10 -18 30 -6 q22 -4 22 18 q10 8 0 18 H74 q-14 -4 -4 -12 Z" /></g>
  <g class="drift d4"><path class="f-white" d="M250 46 q4 -16 20 -13 q8 -13 22 -4 q16 -3 16 13 q8 6 0 13 H254 q-10 -3 -4 -9 Z" /></g>
  <path class="ink" d="M20 262 H620" />
  <path class="f-orange" d="M130 262 V230 H200 V198 H270 V166 H340 V134 H410 V102 H480 V262 Z" />
  <path class="ink-thin" d="M200 230 V262 M270 198 V262 M340 166 V262 M410 134 V262" />
  <g class="climb-smooth" style="--cx: 280px; --cy: -128px">
    <g transform="translate(165 230) scale(1.5)">
      <g class="m bob">
        <path class="ink" d="M-9 0 L-2 -22 L6 0" />
        <path class="ink" d="M-2 -22 V-50" />
        <path class="ink" d="M-2 -44 L-18 -32 M-2 -44 L14 -58" />
        <circle class="f-white" cx="-2" cy="-64" r="14" />
        <path class="f-amber" d="M-16 -66 q2 -16 16 -14 q14 0 12 12 q-8 -6 -14 -2 q-8 -6 -14 4 Z" />
        <circle class="f-ink" cx="2" cy="-62" r="1.6" />
        <circle class="f-ink" cx="8" cy="-62" r="1.6" />
      </g>
    </g>
  </g>
  <g class="lift">
    <g transform="translate(560 244)">
      <path class="f-brand" d="M0 -80 C16 -62 18 -30 15 0 H-15 C-18 -30 -16 -62 0 -80 Z" />
      <circle class="f-white" cx="0" cy="-44" r="7" />
      <path class="f-brand" d="M-15 -16 L-27 4 L-15 0 Z M15 -16 L27 4 L15 0 Z" />
      <path class="f-amber m flicker" d="M-9 2 Q0 30 9 2 Z" />
    </g>
  </g>
</svg>
