---
import { existsSync, readFileSync } from 'node:fs';
import { join } from 'node:path';
import { learnPath } from '../lib/modules';

// Use the real logo once public/logos/SS2.png is added. Until then, show a text wordmark.
const logoFile = join(process.cwd(), 'public', 'logos', 'SS2.png');
let logo: { width: number; height: number } | null = null;
if (existsSync(logoFile)) {
  const png = readFileSync(logoFile);
  // PNG IHDR: width and height are big-endian uint32 at bytes 16 and 20.
  const w = png.readUInt32BE(16);
  const h = png.readUInt32BE(20);
  logo = { width: Math.round((w / h) * 32), height: 32 };
}

const links = [
  { href: 'https://startupstairs.in/startup-league', label: 'Startup League' },
  { href: 'https://startupstairs.in/incubation', label: 'Get Incubated' },
  { href: 'https://startupstairs.in/mentorship', label: 'Get Mentored' },
  { href: 'https://scorecard.startupstairs.in/', label: 'Scorecard' },
];
const onLearn = Astro.url.pathname.startsWith(learnPath);
---

<header class="sticky top-0 z-30 border-b border-line bg-surface">
  <div class="mx-auto flex h-16 max-w-[1440px] items-center justify-between gap-4 px-4 sm:px-6">
    <a href="https://startupstairs.in/" class="flex shrink-0 items-center gap-2 text-ink no-underline">
      {
        logo ? (
          <img src="/logos/SS2.png" alt="Startup Stairs" width={logo.width} height={logo.height} class="h-8 w-auto" />
        ) : (
          <span class="font-serif text-lg font-semibold tracking-tight">Startup Stairs</span>
        )
      }
    </a>

    <nav aria-label="Main" class="hidden md:block">
      <ul class="flex items-center gap-1 text-[0.9375rem]">
        {
          links.map((l) => (
            <li>
              <a href={l.href} class="rounded-md px-3 py-2 text-muted hover:text-ink">
                {l.label}
              </a>
            </li>
          ))
        }
        <li>
          <a
            href={learnPath}
            aria-current={onLearn ? 'page' : undefined}
            class="rounded-md px-3 py-2 font-medium text-ink underline decoration-accent decoration-2 underline-offset-[10px]"
          >
            Learn
          </a>
        </li>
      </ul>
    </nav>

    <details class="site-menu relative md:hidden">
      <summary
        class="btn btn-secondary min-h-10 cursor-pointer list-none px-3 py-1.5 text-sm [&::-webkit-details-marker]:hidden"
      >
        Menu
      </summary>
      <nav
        aria-label="Main"
        class="absolute right-0 mt-2 w-56 rounded-[var(--radius-card)] border border-line bg-surface py-2"
      >
        <ul>
          {
            links.map((l) => (
              <li>
                <a href={l.href} class="block px-4 py-2.5 text-ink hover:bg-subtle">
                  {l.label}
                </a>
              </li>
            ))
          }
          <li>
            <a
              href={learnPath}
              aria-current={onLearn ? 'page' : undefined}
              class="block border-l-2 border-accent px-4 py-2.5 font-medium text-ink hover:bg-subtle"
            >
              Learn
            </a>
          </li>
        </ul>
      </nav>
    </details>
  </div>
</header>

<script>
  // Close the mobile menu on Escape or when clicking outside it.
  const menu = document.querySelector<HTMLDetailsElement>('details.site-menu');
  if (menu) {
    document.addEventListener('keydown', (e) => {
      if (e.key === 'Escape' && menu.open) {
        menu.open = false;
        menu.querySelector('summary')?.focus();
      }
    });
    document.addEventListener('click', (e) => {
      if (menu.open && !menu.contains(e.target as Node)) menu.open = false;
    });
  }
</script>
