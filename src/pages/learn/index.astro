---
import Base from '../../layouts/Base.astro';
import { modulePath, modules, totalMinutes } from '../../lib/modules';

const liveCount = modules.filter((m) => m.status === 'live').length;
---

<Base
  title="Startup Stairs Business School: free business lessons for founders"
  description="Free, short lessons on the numbers behind a business, in easy English. Start with Module 1: Understanding Unit Economics."
>
  <div class="mx-auto max-w-[760px] px-4 pt-10 pb-16 sm:px-6 sm:pt-14">
    <p class="eyebrow">Free course</p>
    <h1 class="mt-2 text-[2.125rem] leading-tight sm:text-[2.5rem]">Startup Stairs Business School</h1>
    <p class="mt-4 text-lg text-muted">
      Short lessons on the numbers behind a business. Written in easy English for founders and students. Each module
      takes under 30 minutes, with worked examples and practice questions.
    </p>
    <p class="mt-4 text-sm text-muted">
      {modules.length} modules
      <span aria-hidden="true" class="mx-1.5">·</span>
      {liveCount} live now
      <span aria-hidden="true" class="mx-1.5">·</span>
      No sign up needed
    </p>

    <h2 class="mt-14 text-[1.5rem]">Modules</h2>
    <ol class="mt-4 overflow-hidden rounded-[var(--radius-card)] border border-line bg-surface">
      {
        modules.map((m) => (
          <li class="border-b border-line last:border-b-0">
            {m.status === 'live' ? (
              <a href={modulePath(m)} class="group block px-4 py-5 hover:bg-subtle sm:px-6">
                <span class="eyebrow block">Module {m.moduleNumber}</span>
                <span class="mt-1 block text-lg font-medium text-ink group-hover:text-accent-text">{m.title}</span>
                <span class="mt-1 block text-muted">{m.summary}</span>
                <span class="mt-2 block text-sm text-muted">
                  {m.chapters.length} chapters<span aria-hidden="true" class="mx-1.5">·</span>{totalMinutes(m)} min<span aria-hidden="true" class="mx-1.5">·</span><span data-progress data-module={m.slug} data-total={m.chapters.length} data-chapters={JSON.stringify(m.chapters.map((c) => c.slug))}>0%</span>{' '}done
                </span>
              </a>
            ) : (
              <div class="px-4 py-5 sm:px-6">
                <span class="flex items-center justify-between gap-3">
                  <span class="eyebrow">Module {m.moduleNumber}</span>
                  <span class="rounded-md border border-line px-2 py-0.5 text-xs text-muted">Coming soon</span>
                </span>
                <span class="mt-1 block text-lg font-medium text-muted">{m.title}</span>
                <span class="mt-1 block text-muted">{m.summary}</span>
              </div>
            )}
          </li>
        ))
      }
    </ol>
  </div>
</Base>

<script>
  import { initProgress } from '../../scripts/progress';
  initProgress();
</script>
